<!DOCTYPE html>
<html>
<head>
    <title>Input Validation</title>
</head>
<body>

    <h1>Student Form</h1>

    <form action="/submit" method="POST">

        <label>Name:</label>
        <input type="text" name="name">

        <br><br>

        <label>Age:</label>
        <input type="number" name="age">

        <br><br>

        <button type="submit">Submit</button>

    </form>

    <% if (error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <% if (message) { %>
        <p style="color: green;"><%= message %></p>
    <% } %>

</body>
</html>